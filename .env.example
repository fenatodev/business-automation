# Database connection used by the API and Alembic.
# Replace with your local development database URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/business_automation

# Ollama configuration.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional variables used by docker-compose.yml for the local PostgreSQL service.
POSTGRES_DB=business_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
