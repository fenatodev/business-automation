# Private Client 0 pilot template.
# Copy to .env locally; .env is ignored by Git.
#
# Choose a loopback-only host port that is free on this machine.
POSTGRES_PORT=55432
POSTGRES_DB=business_automation
POSTGRES_USER=business_automation

# REQUIRED before startup.
# Generate a high-entropy password locally, for example:
#   openssl rand -hex 32
# Do not paste the generated value into Git or documentation.
POSTGRES_PASSWORD=

# REQUIRED before running Alembic/API.
# Build this from the same local PostgreSQL values above.
# Example shape only:
# postgresql+psycopg://<user>:<password>@127.0.0.1:<port>/<database>
DATABASE_URL=

# Fail closed until real private identities are configured locally.
# Store only token SHA-256 values here, never raw Bearer tokens.
BA_ACCESS_IDENTITIES_JSON=[]

# Optional local agent configuration.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
